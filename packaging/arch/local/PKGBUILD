# Maintainer: reprise-project

# Local install of this checkout: packaging/arch/local/build.sh -si
# build.sh runs makepkg on a copy from a scratch startdir, since makepkg writes
# pkgver() back and puts src/ and pkg/ beside the PKGBUILD. pkgver is a placeholder.
pkgname=reprise
pkgver=0.1.0
pkgrel=1
pkgdesc="Wayland desktop with a classic retro look, with Notepad, Explorer and a settings sheet"
arch=('x86_64')
url="https://github.com/reprise-project/reprise-desktop"
license=('GPL-3.0-or-later')
depends=('seatd' 'systemd' 'systemd-libs' 'libinput>=1.26' 'libdrm' 'mesa' 'libglvnd' 'libdisplay-info' 'libxkbcommon' 'xorg-xwayland' 'freetype2' 'fontconfig' 'pam' 'libxcrypt' 'dbus>=1.15' 'pipewire>=1:1.4' 'zlib' 'ffmpeg')
makedepends=('cargo' 'clang' 'pkgconf' 'git')
optdepends=('ttf-tahoma: Wine'\''s Tahoma, the UI font the layouts are tuned for'
            'ttf-dejavu: fallback font' 'noto-fonts-cjk: Chinese, Japanese and Korean text'
            'wqy-bitmapfont: crisp Chinese text in Reprise'\''s own text with antialias = false'
            'noto-fonts-emoji: the colour emoji in the Super+. picker'
            'xdg-utils: open a file with no default program, the Start menu Internet and Help rows, the Edit File... button in Reprise Settings, and a network'\''s sign-in page'
            'shared-mime-info: file kinds and icons on the desktop, in Explorer and on Properties'
            'bubblewrap: the jail the thumbnailers run in; without it only pictures get thumbnails'
            'papers: PDF, PostScript, DjVu and comic book thumbnails in Explorer and the file dialogs (evince-thumbnailer from evince works too)'
            'ffmpegthumbnailer: video thumbnails in Explorer and the file dialogs'
            'gnome-font-viewer: font thumbnails in Explorer and the file dialogs'
            'libgsf: OpenDocument and Office document thumbnails in Explorer and the file dialogs'
            'libarchive: bsdtar, which Send To > Compressed (zipped) Folder, Extract Here and Extract to shell out to'
            'wireplumber: wpctl, which reprise-sound, reprise-volume, the volume keys and Remote Desktop sound set the default device, volume and mute with'
            'upower: the battery behind the reprise-power tray icon and the on-battery idle timeouts'
            'power-profiles-daemon: the power profile in Power Options and the battery icon menu'
            'xdg-desktop-portal>=1.19: screen sharing, screenshots, and Deskflow through the portals (reprise-portal is the backend), and file drags into Flatpak programs'
            'xdg-desktop-portal-wlr: the ScreenCast and Screenshot fallback reprise-portals.conf names after reprise-portal'
            'xdg-desktop-portal-gtk: printing from GTK3 programs, the Print portal reprise-portals.conf names'
            'gnome-themes-extra: the dark theme GTK3 programs take under a dark look'
            'qt6ct: Qt 6 programs in the colours of the look ([toolkits] qt_platform_theme = "reprise")'
            'qt5ct: Qt 5 programs in the colours of the look ([toolkits] qt_platform_theme = "reprise")'
            'pipewire-pulse: desktop and microphone audio in OBS and browsers'
            'sound-theme-freedesktop: the sound a notification balloon plays'
            'networkmanager: reprise-network, the network tray icon and Network Connections'
            'dnsmasq: sharing the connection from a hotspot in Network Connections'
            'networkmanager-openvpn: OpenVPN connections, and importing .ovpn files in Network Connections'
            'bluez: reprise-bluetooth, the Bluetooth tray icon and Bluetooth Devices'
            'kdeconnect: reprise-phone, the phone tray icon (battery, Ring phone, Send files), and phones in Send To'
            'udisks2: reprise-drives (drives mounted as they are plugged in, Safely Remove Hardware), and unmounted drives and Eject in Computer'
            'packagekit: reprise-updates, the updates tray icon and Software Updates'
            'flatpak: Flatpak application and runtime updates in Software Updates'
            'fwupd: firmware updates in Software Updates (curl, which pacman needs too, downloads them)'
            'accountsservice: reprise-accounts (User Accounts) and the user pictures on the login screen'
            'cups: reprise-printers, Printers, print queues and the printing tray icon'
            'cups-filters: driverless IPP Everywhere and AirPrint printers, and the test page, in Printers'
            'cups-pk-helper: changing printers in Printers with an administrator password, for accounts outside the CUPS admin group'
            'avahi: network printers in the Add Printer wizard without an administrator password, for accounts outside the CUPS admin group'
            'polkit: the password prompt behind pkexec, udisks and NetworkManager system actions (reprise-polkit)'
            'gnome-keyring: saved passwords for browsers and other programs, unlocked through PAM (pam_gnome_keyring) at login and by the lock screen password, and the Secret portal for sandboxed programs'
            'fprintd: fingerprint unlock on the lock screen, and in the admin password prompt when the polkit-1 PAM stack has pam_fprintd'
            'ddcutil: external monitors'\'' brightness over DDC/CI'
            'at-spi2-core: screen readers (Orca) in Reprise and its programs'
            'libx11: the Compose files behind dead keys and the Compose key in the lock screen password'
            'hwdata: graphics card names in About Reprise and Task Manager (pci.ids)'
            'geoclue: the location prompt and the location indicator (Reprise is the geoclue agent)'
            'intel-media-driver: hardware H.264 for Remote Desktop on Intel graphics'
            'libva-mesa-driver: hardware H.264 for Remote Desktop on AMD graphics'
            'nvidia-utils: hardware H.264 (NVENC) for Remote Desktop on NVIDIA graphics')
provides=('reprise')
conflicts=('reprise-git')
backup=('etc/pam.d/reprise' 'etc/pam.d/reprise-fingerprint' 'etc/pam.d/reprise-rdp'
        'etc/pam.d/reprise-login' 'etc/pam.d/reprise-login-greeter' 'etc/pam.d/reprise-login-autologin'
        'etc/pam.d/reprise-login-remote' 'etc/pam.d/reprise-login-remote-nla' 'etc/pam.d/reprise-login-check')
# makepkg's lto turns the C shim in libspa-sys into GCC bitcode that rustc's
# lld cannot link (undefined *_libspa_rs symbols in reprise-portal). The option
# only touches CFLAGS, CXXFLAGS and LDFLAGS; Rust LTO follows Cargo.toml's
# release profile.
options=(!lto)
# makepkg's debug option appends DEBUG_RUSTFLAGS (-C debuginfo=2 on Arch) to RUSTFLAGS,
# overriding the release profile: line tables keep backtraces at file:line.
DEBUG_RUSTFLAGS="-C debuginfo=line-tables-only"
# makepkg's strip step runs gdb-add-index on each binary whenever gdb is installed
# (debugedit in base-devel pulls it in); the index only speeds up gdb's first load and
# is a fifth of the debug package. The strip step calls this function in its place.
gdb-add-index() { :; }
source=()

_repo() {
  printf '%s' "${REPRISE_REPO:-$startdir/../../..}"
}

# CI's package check builds with a faster profile; a package for use is built with release.
_profile=${REPRISE_CARGO_PROFILE:-release}

pkgver() {
  cd "$(_repo)"
  local ver
  ver="$(awk -F'"' '/^version = /{print $2; exit}' Cargo.toml)"
  if git rev-parse --git-dir >/dev/null 2>&1; then
    printf '%s.r%s.%s' "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  else
    printf '%s' "$ver"
  fi
}

build() {
  cd "$(_repo)"
  export RUSTUP_TOOLCHAIN=stable
  # The About boxes show it as the build id.
  if git rev-parse --git-dir >/dev/null 2>&1; then
    export REPRISE_BUILD="$(git rev-parse --short HEAD)"
  fi
  # Keeps packaging out of the working tree's target/.
  export CARGO_TARGET_DIR="$srcdir/target"
  # Panic locations carry absolute source paths: map the build tree and the
  # cargo home (registry and git checkouts) to fixed prefixes.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgbase --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo"
  # Named explicitly: the workspace has a root package, so a bare build
  # would build only that.
  cargo build --profile "$_profile" --locked -p reprise -p reprise-portal -p reprise-apps -p reprise-rdp -p reprise-login -p reprise-login-rdp
}

package() {
  cd "$(_repo)"
  install -Dm755 "$srcdir/target/$_profile/reprise" "$pkgdir/usr/bin/reprise"
  # One binary holds every program; each name links to it.
  install -Dm755 "$srcdir/target/$_profile/reprise-apps" "$pkgdir/usr/bin/reprise-apps"
  for app in reprise-notepad reprise-explorer reprise-about reprise-sound reprise-volume reprise-settings reprise-power reprise-datetime reprise-accounts reprise-network reprise-bluetooth reprise-drives reprise-polkit reprise-updates reprise-printers reprise-terminal reprise-phone reprise-diskusage reprise-notes reprise-fonts reprise-imageviewer reprise-paint reprise-calc reprise-charmap reprise-taskmgr; do
    ln -s reprise-apps "$pkgdir/usr/bin/$app"
    install -Dm644 "data/apps/$app.desktop" "$pkgdir/usr/share/applications/$app.desktop"
  done
  for app in reprise-sound reprise-power reprise-network reprise-bluetooth reprise-drives reprise-polkit reprise-updates reprise-printers reprise-phone reprise-notes; do
    install -Dm644 "data/autostart/$app.desktop" "$pkgdir/etc/xdg/autostart/$app.desktop"
  done
  install -Dm755 "$srcdir/target/$_profile/reprise-rdp" "$pkgdir/usr/bin/reprise-rdp"
  install -Dm755 "$srcdir/target/$_profile/reprise-login" "$pkgdir/usr/bin/reprise-login"
  install -Dm755 "$srcdir/target/$_profile/reprise-login-settings" "$pkgdir/usr/lib/reprise/reprise-login-settings"
  install -Dm755 "$srcdir/target/$_profile/reprise-login-rdp" "$pkgdir/usr/bin/reprise-login-rdp"
  install -Dm644 data/systemd/reprise-login-rdp.service "$pkgdir/usr/lib/systemd/system/reprise-login-rdp.service"
  install -Dm644 data/systemd/reprise-login-rdp.socket "$pkgdir/usr/lib/systemd/system/reprise-login-rdp.socket"
  install -Dm644 data/systemd/reprise-rdp-handover.socket "$pkgdir/usr/lib/systemd/user/reprise-rdp-handover.socket"
  install -Dm644 data/systemd/reprise-rdp-handover.service "$pkgdir/usr/lib/systemd/user/reprise-rdp-handover.service"
  install -d "$pkgdir/usr/lib/systemd/user/sockets.target.wants"
  ln -s ../reprise-rdp-handover.socket "$pkgdir/usr/lib/systemd/user/sockets.target.wants/reprise-rdp-handover.socket"
  install -Dm644 data/polkit-1/rules.d/50-reprise-login.rules "$pkgdir/usr/share/polkit-1/rules.d/50-reprise-login.rules"
  install -Dm644 data/polkit-1/actions/org.reprise.login.policy "$pkgdir/usr/share/polkit-1/actions/org.reprise.login.policy"
  install -Dm644 data/systemd/reprise-login.service "$pkgdir/usr/lib/systemd/system/reprise-login.service"
  install -Dm644 data/sysusers.d/reprise-login.conf "$pkgdir/usr/lib/sysusers.d/reprise-login.conf"
  install -Dm644 data/tmpfiles.d/reprise-login.conf "$pkgdir/usr/lib/tmpfiles.d/reprise-login.conf"
  install -Dm644 data/systemd/app-org.reprise.RemoteDesktop.service "$pkgdir/usr/lib/systemd/user/app-org.reprise.RemoteDesktop.service"
  install -Dm644 data/apps/org.reprise.RemoteDesktop.desktop "$pkgdir/usr/share/applications/org.reprise.RemoteDesktop.desktop"
  install -Dm755 "$srcdir/target/$_profile/reprise-portal" "$pkgdir/usr/bin/reprise-portal"
  install -Dm644 data/portal/reprise.portal "$pkgdir/usr/share/xdg-desktop-portal/portals/reprise.portal"
  install -Dm644 data/portal/reprise-settings.portal "$pkgdir/usr/share/xdg-desktop-portal/portals/reprise-settings.portal"
  install -Dm644 data/portal/org.freedesktop.impl.portal.desktop.reprise.service "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.reprise.service"
  install -Dm644 data/portal/reprise-portal.service "$pkgdir/usr/lib/systemd/user/reprise-portal.service"
  install -Dm644 data/systemd/reprise-session.target "$pkgdir/usr/lib/systemd/user/reprise-session.target"
  install -Dm644 data/reprise.desktop "$pkgdir/usr/share/wayland-sessions/reprise.desktop"
  for size in 16x16 24x24 32x32 48x48; do
    install -Dm644 "data/icons/hicolor/$size/apps/reprise.png" "$pkgdir/usr/share/icons/hicolor/$size/apps/reprise.png"
  done
  install -Dm644 data/icons/hicolor/scalable/apps/reprise.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/reprise.svg"
  install -Dm644 data/reprise-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/reprise-portals.conf"
  install -Dm644 data/reprise-mimeapps.list "$pkgdir/usr/share/applications/reprise-mimeapps.list"
  install -Dm644 data/pam.d/reprise "$pkgdir/etc/pam.d/reprise"
  install -Dm644 data/pam.d/reprise-fingerprint "$pkgdir/etc/pam.d/reprise-fingerprint"
  install -Dm644 data/pam.d/reprise-rdp "$pkgdir/etc/pam.d/reprise-rdp"
  install -Dm644 data/pam.d/reprise-login "$pkgdir/etc/pam.d/reprise-login"
  install -Dm644 data/pam.d/reprise-login-greeter "$pkgdir/etc/pam.d/reprise-login-greeter"
  install -Dm644 data/pam.d/reprise-login-autologin "$pkgdir/etc/pam.d/reprise-login-autologin"
  install -Dm644 data/pam.d/reprise-login-remote "$pkgdir/etc/pam.d/reprise-login-remote"
  install -Dm644 data/pam.d/reprise-login-remote-nla "$pkgdir/etc/pam.d/reprise-login-remote-nla"
  install -Dm644 data/pam.d/reprise-login-check "$pkgdir/etc/pam.d/reprise-login-check"
  install -Dm644 data/geoclue/90-reprise.conf "$pkgdir/etc/geoclue/conf.d/90-reprise.conf"
  install -Dm644 config.example.toml "$pkgdir/usr/share/doc/reprise/config.example.toml"
  for ftl in data/locale/*/*.ftl; do
    install -Dm644 "$ftl" "$pkgdir/usr/share/reprise/locale/${ftl#data/locale/}"
  done
}
