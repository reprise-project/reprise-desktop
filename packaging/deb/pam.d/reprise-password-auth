#%PAM-1.0
# The password check Reprise's password stacks include on Ubuntu in place of common-auth, so a
# fingerprint profile enabled there never takes the password prompt. Site modules (sss, krb5) go here.
auth      [success=1 default=ignore]  pam_unix.so nullok
auth      requisite                   pam_deny.so
auth      required                    pam_permit.so
-auth     optional                    pam_cap.so
