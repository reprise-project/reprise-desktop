[Unit]
Description=Reprise login manager: Remote Desktop logins
PartOf=reprise-login.service
Requires=reprise-login-rdp.socket
After=reprise-login-rdp.socket reprise-login.service network.target

[Service]
# "+" loads the kernel's tls module outside the sandbox; "-" starts the front when that fails.
ExecStartPre=-+/usr/bin/modprobe -q tls
ExecStart=/usr/bin/reprise-login-rdp
User=reprise-login-rdp
Group=reprise-login-rdp
StateDirectory=reprise-login-rdp
StateDirectoryMode=0700
RuntimeDirectory=reprise-login-rdp
RuntimeDirectoryMode=0755
Restart=on-failure
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# /run holds only the link to reprise-login and the RuntimeDirectory.
TemporaryFileSystem=/run:ro
BindReadOnlyPaths=/run/reprise-login
# The port's socket comes from reprise-login-rdp.socket and works from the empty namespace.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
SocketBindDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# The front confines itself further with seccomp and Landlock.
SystemCallFilter=landlock_create_ruleset landlock_restrict_self
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=64

# No [Install]: reprise-login starts and stops the front and its socket.
