[Unit]
Description=Reprise Remote Desktop server for connections the login manager hands over
# A refused hand-over costs two starts; a start limit would leave the socket failed after a few.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/reprise-rdp --hand-over
Restart=on-failure
RestartSec=2
# A server that keeps crashing at start waits up to a minute between tries.
RestartSteps=5
RestartMaxDelaySec=60
# 75: another process holds org.reprise.RemoteDesktop; the next hand-over starts it again.
RestartPreventExitStatus=75
