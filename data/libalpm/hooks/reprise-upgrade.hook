# Sessions started before an upgrade run the old binaries until they log off;
# /run/reboot-required makes Software Updates show its restart notice, and
# reprise in /run/reboot-required.pkgs says logging off is enough.
[Trigger]
Operation = Upgrade
Type = Path
Target = usr/bin/reprise

[Action]
Description = Asking running Reprise sessions to restart...
When = PostTransaction
Exec = /bin/sh -c 'touch /run/reboot-required && { grep -qsx reprise /run/reboot-required.pkgs || echo reprise >>/run/reboot-required.pkgs; }'
