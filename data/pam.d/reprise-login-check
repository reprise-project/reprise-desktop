#%PAM-1.0
# Checks a password and opens nothing: Remote Desktop password changes and the login screen's
# administrator prompt. system-auth, so pam_nologin never refuses it. Root is refused first.
auth      [success=ok user_unknown=ignore default=die] pam_succeed_if.so quiet_success uid ne 0
auth      include   system-auth
account   include   system-auth
