#%PAM-1.0
# Remote Desktop logins with the login password. pam_unix alone checks it, with no fail delay and no
# pam_faillock: reprise-login throttles failures and times every refusal. Root is refused first.
auth      [success=ok user_unknown=ignore default=die] pam_succeed_if.so quiet_success uid ne 0
auth      required  pam_shells.so
auth      required  pam_env.so
auth      required  pam_unix.so nodelay
-auth     optional  pam_gnome_keyring.so
-auth     optional  pam_kwallet5.so
account   include   system-login
session   optional  pam_keyinit.so force revoke
session   include   system-login
-session  optional  pam_gnome_keyring.so auto_start
-session  optional  pam_kwallet5.so auto_start
