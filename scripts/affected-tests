#!/usr/bin/env bash
# Usage: scripts/affected-tests [--dry-run] [BASE] [nextest args...]
# Builds and runs the tests of every workspace member that the changes since
# merge-base(BASE, HEAD) can affect (default BASE: origin/main; the working
# tree and untracked files count): each changed member plus its reverse
# dependencies. A change under packaging/ runs reprise-updates' tests. The
# scanners that read the whole tree (SCANNERS below) run on any member or
# packaging change. A change elsewhere outside the members runs everything.
# Only libraries, binaries and test targets are built, plus the one example
# that holds tests (reprisekit's gallery); the other examples are not linked.
# --dry-run prints the crate set and the commands instead of running them.
set -euo pipefail
cd "$(dirname "$0")/.."
dry=
if [ "${1:-}" = --dry-run ]; then dry=1; shift; fi
base=${1:-origin/main}
shift || true

mb=$(git merge-base "$base" HEAD)
files=$( { git diff --name-only "$mb"; git ls-files -o --exclude-standard; } | sort -u)

# Prints "ALL" or "<changed members>\t<affected members>\t<scanners>": the affected members
# are the changed ones and their reverse deps, the scanners "package:test" pairs to add.
sets=$(cargo metadata --format-version 1 --no-deps --locked | FILES=$files python3 -I -c '
import json, os, sys

meta = json.load(sys.stdin)
root = meta["workspace_root"]
names = {p["name"] for p in meta["packages"]}
dirs = {}
for p in meta["packages"]:
    d = os.path.relpath(os.path.dirname(p["manifest_path"]), root)
    dirs[d] = p["name"]
root_name = dirs.pop(".", None)

# Read by tests or include_str! across crates, or configure every build.
everything = ("Cargo.toml", "Cargo.lock", ".config/", "data/", "protocols/", "scripts/",
              "config.example.toml", ".github/ci-image/", ".github/workflows/")
inert = ("docs/", ".github/", "README.md", "CONTRIBUTING.md", "SECURITY.md", "LICENSE",
         ".gitignore")
root_paths = ("src/", "tests/", "examples/", "benches/", "build.rs")
# Tests that read files outside their own crate: string ids, window ids, test D-Bus serving,
# licence citations, packaging invariants. A pull request runs them whatever crate it changes.
SCANNERS = (("reprisekit", "i18n"), ("repriseapp", "win_names"), ("reprisebus", "served"),
            ("reprisechecks", "licences"), ("reprisechecks", "packaging"))
# Unit tests that read packaging/.
PACKAGING = ("reprise-updates",)

changed = set()
packaging = False
for f in os.environ["FILES"].split("\n"):
    if not f:
        continue
    if f.startswith(everything):
        print("ALL")
        sys.exit()
    if f.startswith("packaging/"):
        packaging = True
        continue
    hit = [d for d in dirs if f.startswith(d + "/")]
    if hit:
        changed.add(dirs[max(hit, key=len)])
    elif root_name and f.startswith(root_paths):
        changed.add(root_name)
    elif f.startswith(inert) or f.endswith(".local.md"):
        continue
    else:
        print("ALL")
        sys.exit()

users = {n: set() for n in names}
for p in meta["packages"]:
    for dep in p["dependencies"]:
        if dep.get("path") is not None and dep["name"] in names:
            users[dep["name"]].add(p["name"])
affected = set(changed)
todo = list(changed)
while todo:
    for u in users[todo.pop()]:
        if u not in affected:
            affected.add(u)
            todo.append(u)
if packaging:
    affected.update(PACKAGING)
if affected == names:
    print("ALL")
    sys.exit()
scanners = []
if affected:
    scanners = [f"{p}:{t}" for p, t in SCANNERS if p not in affected]
print(" ".join(sorted(changed)) + "\t" + " ".join(sorted(affected)) + "\t" + " ".join(scanners))
')

cmd=(cargo nextest run --locked --lib --bins --tests)
gallery=(--example gallery)
scan=()
case $sets in
  ALL) crates="(whole workspace)"; cmd+=(--workspace "${gallery[@]}") ;;
  $'\t\t') echo "affected-tests: no crate changed since $base"; exit 0 ;;
  *)
    rest=${sets#*$'\t'}
    crates=${rest%%$'\t'*}
    scanners=${rest#*$'\t'}
    for c in $crates; do
      cmd+=(-p "$c")
      [ "$c" = reprisekit ] && cmd+=("${gallery[@]}")
    done
    if [ -n "$scanners" ]; then
      scan=(cargo nextest run --locked)
      for p in $(printf '%s\n' $scanners | cut -d: -f1 | sort -u); do scan+=(-p "$p"); done
      for t in $scanners; do scan+=(--test "${t#*:}"); done
      scan+=("$@")
    fi
    ;;
esac
cmd+=("$@")

if [ -n "$dry" ]; then
  echo "crates: $crates"
  printf 'command:'; printf ' %q' "${cmd[@]}"; echo
  if [ ${#scan[@]} -gt 0 ]; then printf 'scanners:'; printf ' %q' "${scan[@]}"; echo; fi
  exit 0
fi
status=0
"${cmd[@]}" || status=$?
if [ ${#scan[@]} -gt 0 ]; then "${scan[@]}" || status=$?; fi
exit "$status"
