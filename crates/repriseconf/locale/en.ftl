# The texts repriseconf gives programs to show.

## A shortcut's keys that would not bind
keys-no-key = A shortcut ends in a key, as in Super+Shift+b.
keys-bad-modifier = The modifiers are Super, Ctrl, Alt and Shift.
keys-unknown-key = The key is not one the keyboard layout names, as in b, F5 or Return.

