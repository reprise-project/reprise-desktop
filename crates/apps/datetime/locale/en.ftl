# Date and Time. An & marks the next letter as the access key.

title = Date and Time Properties
tab-date = Date & Time
tab-zone = Time Zone

## The Date & Time tab
group-date = Date
group-time = Time
ntp = Automatically &synchronize with an Internet time server
# $locale is the LC_TIME locale dates are written in ("hu_HU"), $example today's short date in it.
regional-format = Regional format: { $locale } ({ $example })

## The Time Zone tab
auto-zone = Set time &zone automatically
dst = Automatically adjust clock for daylight saving changes
# Under "Set time zone automatically" while it cannot be turned on.
blocked-no-geoclue = Install geoclue, the location service, first.
blocked-location-off = Turn on Location in Settings > Privacy first.
blocked-not-allowed = Ask an administrator to allow time zone changes.

## Message boxes
# $error is the system's own message.
change-failed = The clock could not be changed: { $error }
