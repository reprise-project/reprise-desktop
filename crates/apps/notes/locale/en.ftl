# Sticky Notes. An & marks the next letter as the access key.

name = Sticky Notes
# A note's window title while its text is empty.
untitled = Sticky Note
menu-new = &New Note
menu-delete = Delete N&ote
confirm-delete = Are you sure you want to delete this note?
# A note's save failed; $error is the system's reason. The save is tried again after a pause.
save-failed = Sticky Notes cannot save this note: { $error }. It keeps trying while the note is open.
